# Copiá este archivo como .env (local) y completá los valores.
# NUNCA subas el archivo .env real a GitHub.

# API key de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_aqui

# (Opcional) Modelo de Gemini a usar. Si no se define, se usa gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash
